#!/bin/sh

set -eu

message_file=${1:?commit-message file is required}
subject=$(sed -n '1p' "$message_file")
pattern='^(feat|fix|docs|test|refactor|perf|build|ci|style|revert|setup)(\([a-z0-9][a-z0-9._/-]*\))?(!)?: .+$'

if printf '%s\n' "$subject" | grep -Eq "$pattern"; then
    exit 0
fi

printf '%s\n' \
    "Invalid commit subject: $subject" \
    "Use: type(optional-scope): short imperative summary" \
    "Allowed types: feat, fix, docs, test, refactor, perf, build, ci, style, revert, setup." \
    >&2
exit 1
